function updateAsset(idx) {
        const asset = fleetData[idx];
        viewer.src = `models/${asset.file}.glb`;
        viewer.setAttribute('ios-src', `models/${asset.file}.usdz`);
        
        viewer.cameraOrbit = "45deg 75deg 100%";
        viewer.fieldOfView = "auto";

        // Exposure control logic
        if (asset.file.includes("212")) {
            viewer.exposure = "0.45";
        } else if (asset.file.includes("121")) {
            viewer.exposure = "1.5"; 
        } else {
            viewer.exposure = "1.1";
        }

        // Remove old hotspots
        viewer.querySelectorAll('.Hotspot').forEach(h => h.remove());
        
        // Generate new hotspots from JSON data
        if (asset.hotspots && asset.hotspots.length > 0) {
            asset.hotspots.forEach(h => {
                const b = document.createElement('button');
                b.className = 'Hotspot'; 
                
                // Keep toggle state consistent
                if (!toggle.checked) b.classList.add('hidden');
                
                b.slot = h.slot;
                b.setAttribute('data-position', h.pos);
                b.setAttribute('data-normal', h.norm || "0m 1m 0m");
                b.setAttribute('data-visibility-attribute', 'visible');
                b.innerHTML = `<div class="HotspotAnnotation">${h.label}</div>`;
                
                b.onclick = () => {
                    viewer.cameraTarget = h.pos;
                    viewer.cameraOrbit = "0deg 90deg 2.5m";
                };
                viewer.appendChild(b);
            });
        }

        // Update UI Text
        document.getElementById('asset-title').innerText = asset.name;
        document.getElementById('spec-crew').innerText = asset.crew;
        document.getElementById('spec-base').innerText = asset.base;
        document.getElementById('spec-dim').innerText = `${asset.weight} / ${asset.length}`;
        document.getElementById('spec-desc').innerText = asset.description;
    }
